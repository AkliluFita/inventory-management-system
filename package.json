{
  "name": "primestock-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "packages/domain"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @primestock/mobile",
    "mobile:android": "npm run android --workspace @primestock/mobile",
    "mobile:ios": "npm run ios --workspace @primestock/mobile",
    "mobile:web": "npm run web --workspace @primestock/mobile",
    "mobile:lint": "npm run lint --workspace @primestock/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @primestock/mobile",
    "mobile:doctor": "npm run doctor --workspace @primestock/mobile",
    "mobile:export:android": "npm run export:android --workspace @primestock/mobile",
    "mobile:build:apk": "cd apps/mobile && npx eas-cli@latest build --platform android --profile preview",
    "web": "npm run dev --workspace @primestock/web",
    "web:build": "npm run build --workspace @primestock/web",
    "web:start": "npm run start --workspace @primestock/web",
    "web:lint": "npm run lint --workspace @primestock/web",
    "web:typecheck": "npm run typecheck --workspace @primestock/web",
    "check": "npm run mobile:lint && npm run mobile:typecheck && npm run web:lint && npm run web:typecheck",
    "start": "npm run mobile",
    "web:app": "npm run web",
    "web:check": "npm run web:lint && npm run web:typecheck"
  }
}
